{
  "name": "skill-deck",
  "version": "0.1.0",
  "mcpName": "io.github.xingbofeng/skill-deck",
  "description": "Adapter local skill folders to prompts, tools, handlers and MCP servers.",
  "type": "module",
  "homepage": "https://skill.counterxing.top",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xingbofeng/skill-deck.git"
  },
  "bugs": {
    "url": "https://github.com/xingbofeng/skill-deck/issues"
  },
  "keywords": [
    "agent",
    "skills",
    "mcp",
    "model-context-protocol",
    "openai",
    "claude",
    "adapter",
    "skilldeck"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "skill-deck": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./openai-chat": {
      "types": "./dist/adapters/openai-chat.d.ts",
      "import": "./dist/adapters/openai-chat.js"
    },
    "./openai-responses": {
      "types": "./dist/adapters/openai-responses.d.ts",
      "import": "./dist/adapters/openai-responses.js"
    },
    "./anthropic": {
      "types": "./dist/adapters/anthropic.d.ts",
      "import": "./dist/adapters/anthropic.js"
    },
    "./openai-agents": {
      "types": "./dist/adapters/openai-agents.d.ts",
      "import": "./dist/adapters/openai-agents.js"
    },
    "./mcp": {
      "types": "./dist/mcp/server.d.ts",
      "import": "./dist/mcp/server.js"
    }
  },
  "files": [
    "dist",
    "assets",
    "packages/adapter/src/template",
    "examples",
    "README.md",
    "README_EN.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "release:check": "npm run lint && npm run typecheck && npm test && npm run build",
    "pack:dry-run": "npm pack --dry-run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "eta": "^4.6.0",
    "gray-matter": "^4.0.3",
    "puppeteer": "^25.0.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.19.0",
    "@typescript-eslint/parser": "^8.19.0",
    "eslint": "^9.17.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "license": "MIT"
}
